<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CheatMenu</AssemblyName>
    <RootNamespace>CheatMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <!-- The panel, in the order PageBundle joins it. -->
  <ItemGroup>
    <EmbeddedResource Include="web\*" LogicalName="CheatMenu.web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Cheat Menu&#10;作弊菜单" />
    <AssemblyMetadata Include="ModManager.Description" Value="A cheat and test menu that opens with F3. It puts every debug tool the game ships with in one panel with tabs: money, items, stats, time, weather, home, farm, danger, exploring, people and more. Every change is listed with the value it had before. Most changes can be undone, and you can save them as a preset. Note: the game reports cheat use to its developer.&#10;一个用 F3 打开的作弊与测试菜单。把游戏里的全部调试工具放进一个分页面板：金钱、物品、属性、时间、天气、家园、农场、危险、探索、人物等。每次修改都会记下修改前的值。大多数修改可以撤销，也可以存为预设。注意：游戏会向开发者报告作弊行为。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Tools" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-CheatMenu" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-CheatMenu/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
